{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "CommunityKey": {
      "title": "CommunityKey",
      "description": "Represents an access key for the WhatsApp community with 1:1 hardware device binding.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique key document identifier."
        },
        "serial": {
          "type": "number",
          "description": "Serial sequence number (1-1000)."
        },
        "key": {
          "type": "string",
          "description": "Unique formatted key code (e.g. WA-XXXX-XXXX)."
        },
        "status": {
          "type": "string",
          "enum": ["available", "claimed", "blocked"],
          "description": "Current lifecycle status of the key."
        },
        "assignedName": {
          "type": "string",
          "description": "Name of the student or member who redeemed the key."
        },
        "assignedDeviceId": {
          "type": "string",
          "description": "Hardware device fingerprint bound to this key."
        },
        "deviceInfo": {
          "type": "string",
          "description": "Human-readable device model and browser string."
        },
        "firstUsedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the key was initially redeemed."
        },
        "lastUsedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the most recent access verification."
        },
        "accessCount": {
          "type": "number",
          "description": "Total count of authorized connections from the bound device."
        }
      },
      "required": ["id", "serial", "key", "status", "accessCount"]
    },
    "AccessLog": {
      "title": "AccessLog",
      "description": "Audit record of key redemption and access attempts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique log identifier."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of access event."
        },
        "key": {
          "type": "string",
          "description": "Key code used in attempt."
        },
        "userName": {
          "type": "string",
          "description": "User name entered during redemption."
        },
        "action": {
          "type": "string",
          "description": "Action type (REDEEMED, AUTHORIZED, DEVICE_MISMATCH, INVALID_KEY, KEY_BLOCKED)."
        },
        "deviceId": {
          "type": "string",
          "description": "Device fingerprint ID."
        },
        "deviceInfo": {
          "type": "string",
          "description": "Client device description."
        },
        "ip": {
          "type": "string",
          "description": "IP address hash or string."
        },
        "notes": {
          "type": "string",
          "description": "Details of the event."
        }
      },
      "required": ["id", "timestamp", "key", "action"]
    },
    "CommunitySettings": {
      "title": "CommunitySettings",
      "description": "Global configuration for StudyVerse WhatsApp Community.",
      "type": "object",
      "properties": {
        "communityName": {
          "type": "string",
          "description": "Name of the community."
        },
        "inviteUrl": {
          "type": "string",
          "format": "uri",
          "description": "Official WhatsApp group invite link."
        },
        "welcomeMessage": {
          "type": "string",
          "description": "Welcome banner text."
        },
        "requireName": {
          "type": "boolean",
          "description": "Whether member name is mandatory."
        },
        "autoRedirect": {
          "type": "boolean",
          "description": "Whether to auto-redirect after successful verification."
        },
        "redirectDelaySeconds": {
          "type": "number",
          "description": "Countdown delay in seconds before redirecting."
        },
        "adminPin": {
          "type": "string",
          "description": "Passcode for administrative controls."
        }
      },
      "required": ["communityName", "inviteUrl"]
    }
  },
  "firestore": {
    "/keys/{keyId}": {
      "schema": "CommunityKey",
      "description": "Registry of 1,000 community activation keys."
    },
    "/logs/{logId}": {
      "schema": "AccessLog",
      "description": "Audit trail of connection and redemption events."
    },
    "/settings/{settingId}": {
      "schema": "CommunitySettings",
      "description": "Global application configuration."
    }
  }
}
